# Safe default: simulated execution only.
AAQTS_EXECUTION_MODE=PAPER
AAQTS_PAPER_STARTING_BALANCE=1000.00
AAQTS_RISK_PERCENT=3.0
AAQTS_BOT_INTERVAL_SECONDS=300
AAQTS_MIN_ADX=20
AAQTS_SIGNAL_SCORE_THRESHOLD=55
AAQTS_MIN_SIGNAL_CONFIRMATIONS=2
AAQTS_MIN_TRADE_QUALITY=55
AAQTS_SINGLE_ACCOUNT_MODE=true
AAQTS_PRIMARY_ACCOUNT_ID=
AAQTS_ACCOUNT_ID=exness_demo
AAQTS_RUNTIME_DIR=runtime

# Market data. MT5_DEMO requires MT5 so the strategy and execution venue share
# one broker feed. PAPER defaults to YAHOO. Demo mode fails closed when broker
# candles are missing/stale and never substitutes cached Yahoo candles.
AAQTS_MARKET_DATA_PROVIDER=
AAQTS_MARKET_DATA_MAX_STALE_BARS=2.5

# Temporary small-account safety gate. These four metals are excluded from both
# scanning and new-order execution by default because their current broker
# minimum-lot risk is too large for a ~$100-$200 account. When account size is
# intentionally increased and sizing is re-validated, set this to an empty
# value to re-enable all catalog defaults, or provide a different comma list.
AAQTS_DISABLED_BROKER_SYMBOLS=XAUUSD,XAGUSD,XPTUSD,XPDUSD

# Optional local integrations. Never commit real values. Copy this file to
# .env locally; .env is gitignored. Rotate any credential ever exposed outside
# the trusted host.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_IDS=
TELEGRAM_RISK_MANAGER_IDS=
TELEGRAM_OPERATOR_IDS=
TELEGRAM_VIEWER_IDS=
TELEGRAM_CONTROL_TOTP_SECRET=

# Global MT5 settings used by the trading engine. In SINGLE_ACCOUNT_MODE the
# Telegram account reader for AAQTS_ACCOUNT_ID reuses these same settings, so a
# second duplicate password/path configuration is not required. If no MT5
# password is supplied, Telegram may read the already-authenticated terminal
# session and still verifies that the returned login matches the registry.
AAQTS_MT5_TERMINAL_PATH=
AAQTS_MT5_LOGIN=
AAQTS_MT5_EXPECTED_LOGIN=
AAQTS_MT5_PASSWORD=
AAQTS_MT5_SERVER=
# Exness trial accounts commonly expose EURUSDm/XAUUSDm/BTCUSDm.
AAQTS_MT5_SYMBOL_SUFFIX=
AAQTS_MT5_FIXED_LOT=0.01
AAQTS_MT5_MAX_OPEN_POSITIONS=5

# Demo risk-account isolation. MT5_DEMO defaults this ON even when the variable
# is omitted. AAQTS still uses the broker for real margin/order checks, but its
# strategy risk sizing, drawdown and PnL baseline are anchored at AAQTS startup
# and then changed only by AAQTS-managed positions/history. This lets another
# EA run on the same demo account without its PnL changing AAQTS risk sizing.
AAQTS_ISOLATE_STRATEGY_RISK=true

# Optional per-account overrides. These are mainly for multi-account setups or
# when one account intentionally uses a different terminal/password. For the
# primary single account they can stay empty because the global MT5 settings
# above are reused.
AAQTS_ACCOUNT_EXNESS_DEMO_LOGIN=
AAQTS_ACCOUNT_EXNESS_DEMO_PASSWORD=
AAQTS_ACCOUNT_EXNESS_DEMO_SERVER=
AAQTS_ACCOUNT_EXNESS_DEMO_TERMINAL_PATH=
AAQTS_ACCOUNT_EXNESS_DEMO_USE_PREAUTHENTICATED_SESSION=

# Production economic-news protection. MT5_DEMO defaults this filter ON.
# Leave CALENDAR_FILE empty to use the refreshing weekly JSON feed. A local
# file, when provided, takes precedence. The remote provider refreshes every
# 30 minutes, caches atomically, and fails closed once its cache exceeds the
# maximum stale age.
AAQTS_NEWS_FILTER_ENABLED=true
AAQTS_NEWS_CALENDAR_FILE=
AAQTS_NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
AAQTS_NEWS_CALENDAR_CACHE=runtime/news_calendar_cache.json
AAQTS_NEWS_REFRESH_MINUTES=30
AAQTS_NEWS_MAX_STALE_MINUTES=360
AAQTS_NEWS_PRE_EVENT_MINUTES=30
AAQTS_NEWS_POST_EVENT_MINUTES=20
AAQTS_NEWS_BLOCKED_IMPACTS=HIGH
