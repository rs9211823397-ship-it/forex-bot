# Safe default: simulated execution only.
AAQTS_EXECUTION_MODE=PAPER
AAQTS_PAPER_STARTING_BALANCE=1000.00
AAQTS_BOT_INTERVAL_SECONDS=300
AAQTS_MIN_ADX=20
AAQTS_SIGNAL_SCORE_THRESHOLD=55
AAQTS_MIN_SIGNAL_CONFIRMATIONS=2
AAQTS_MIN_TRADE_QUALITY=55
AAQTS_SINGLE_ACCOUNT_MODE=true
# Optional when exactly one account is registered. Required to select one
# existing account if a previous registry already contains multiple accounts.
AAQTS_PRIMARY_ACCOUNT_ID=

# Optional local integrations. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Parent-console authorization uses numeric Telegram user IDs. TELEGRAM_CHAT_ID
# remains a backward-compatible single-owner fallback.
TELEGRAM_OWNER_IDS=
TELEGRAM_RISK_MANAGER_IDS=
TELEGRAM_OPERATOR_IDS=
TELEGRAM_VIEWER_IDS=
# Base32 secret generated on the trusted host; required for stop/emergency.
TELEGRAM_CONTROL_TOTP_SECRET=
AAQTS_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
AAQTS_MT5_LOGIN=
AAQTS_MT5_EXPECTED_LOGIN=
AAQTS_MT5_PASSWORD=
AAQTS_MT5_SERVER=
AAQTS_MT5_FIXED_LOT=0.01
AAQTS_MT5_MAX_OPEN_POSITIONS=5

# Account secrets use the account ID converted to uppercase underscores.
# Example account id my_mt5_demo:
# AAQTS_ACCOUNT_EXNESS_MT5_01_PASSWORD=
# AAQTS_ACCOUNT_EXNESS_MT5_01_TERMINAL_PATH=C:\MT5-01\terminal64.exe
# MT4 uses a separately deployed local/HTTPS bridge:
# AAQTS_ACCOUNT_EXNESS_MT4_01_BRIDGE_TOKEN=

# Optional strict local economic calendar. When enabled, a missing or invalid
# calendar blocks new trades rather than silently trading through news.
AAQTS_NEWS_FILTER_ENABLED=false
AAQTS_NEWS_CALENDAR_FILE=config/news_calendar.local.json
