def is_market_open(symbol):
    now_utc = datetime.now(timezone.utc)
    weekday = now_utc.weekday()
    hour = now_utc.hour + now_utc.minute/60
    if any(x in symbol for x in ["BTC","ETH"]):
        return True
    if any(x in symbol for x in ["XAU","XPT","XPD","OIL","USOIL"]):
        if weekday==5 or weekday==6:
            if weekday==6 and hour>=22: return True
            return False
        return True
    else:
        if weekday==5: return False
        if weekday==6 and hour<22: return False
        if weekday==4 and hour>=22: return False
        return True

def get_trend_1h_4h(yf_sym):
    votes=[]
    for tf in ["1h","4h"]:
        try:
            df=yf.download(yf_sym, period="10d", interval=tf, progress=False, auto_adjust=True)
            if df.empty or len(df)<50: continue
            df.columns=[c[0] if isinstance(c,tuple) else c for c in df.columns]
            e20=df['Close'].ewm(20).mean().iloc[-1]
            e50=df['Close'].ewm(50).mean().iloc[-1]
            delta=df['Close'].diff()
            gain=delta.where(delta>0,0).rolling(14).mean()
            loss=-delta.where(delta<0,0).rolling(14).mean()
            rs=gain.iloc[-1]/loss.iloc[-1] if loss.iloc[-1]!=0 else 100
            rsi=100-(100/(1+rs))
            if e20>e50 and rsi>50: votes.append("BUY")
            elif e20<e50 and rsi<50: votes.append("SELL")
        except: continue
    b=votes.count("BUY"); s=votes.count("SELL")
    if b==2: return "BUY"
    if s==2: return "SELL"
    return "HOLD"

def get_entry_5m_15m(yf_sym, trend):
    confirms=[]
    for tf in ["5m","15m"]:
        try:
            df=yf.download(yf_sym, period="2d", interval=tf, progress=False, auto_adjust=True)
            if df.empty or len(df)<50: continue
            df.columns=[c[0] if isinstance(c,tuple) else c for c in df.columns]
            e20=df['Close'].ewm(20).mean().iloc[-1]
            e50=df['Close'].ewm(50).mean().iloc[-1]
            if trend=="BUY" and e20>e50: confirms.append(True)
            elif trend=="SELL" and e20<e50: confirms.append(True)
        except: continue
    return len(confirms)>=1

