def analyze_detailed(yf_sym, name):
    try:
        df_1h = yf.download(yf_sym, period="7d", interval="1h", progress=False, auto_adjust=True)
        df_4h = yf.download(yf_sym, period="30d", interval="4h", progress=False, auto_adjust=True)
        df_15m = yf.download(yf_sym, period="2d", interval="15m", progress=False, auto_adjust=True)
        if df_1h.empty: return None
        for df in [df_1h, df_4h, df_15m]:
            df.columns=[c[0] if isinstance(c,tuple) else c for c in df.columns]
        def calc(df):
            close=df['Close']; e20=close.ewm(20).mean().iloc[-1]; e50=close.ewm(50).mean().iloc[-1]
            delta=close.diff(); gain=delta.where(delta>0,0).rolling(14).mean().iloc[-1]; loss=-delta.where(delta<0,0).rolling(14).mean().iloc[-1]
            rsi=100-(100/(1+(gain/loss if loss!=0 else 100)))
            return e20,e50,rsi,close.iloc[-1]
        e20_1h,e50_1h,rsi_1h,price=calc(df_1h)
        e20_4h,e50_4h,rsi_4h,_=calc(df_4h)
        e20_15,e50_15,rsi_15,_=calc(df_15m)
        bullish_1h = e20_1h>e50_1h and rsi_1h>45
        bearish_1h = e20_1h<e50_1h and rsi_1h<55
        bullish_4h = e20_4h>e50_4h and rsi_4h>45
        bearish_4h = e20_4h<e50_4h and rsi_4h<55
        positive=[]; rejection=[]
        if bullish_1h: positive.append(f"1H Bull EMA {e20_1h:.2f} > {e50_1h:.2f}")
        if bearish_1h: positive.append(f"1H Bear EMA {e20_1h:.2f} < {e50_1h:.2f}")
        if bullish_4h and bullish_1h: positive.append("MTF CONFIRMED")
        if bearish_4h and bearish_1h: positive.append("MTF CONFIRMED")
        if bullish_1h and not bullish_4h: rejection.append(f"1H BULL but 4H BEAR RSI {rsi_4h:.0f}")
        if bearish_1h and not bearish_4h: rejection.append(f"1H BEAR but 4H BULL RSI {rsi_4h:.0f}")
        if not bullish_1h and not bearish_1h: rejection.append(f"1H flat RSI {rsi_1h:.0f}")
        if rsi_1h>60 or rsi_1h<40: positive.append(f"Strong RSI {rsi_1h:.0f}")
        else: rejection.append(f"Weak RSI {rsi_1h:.0f}")
        if bullish_1h and bullish_4h and e20_15>e50_15: decision="BUY"; conf=75; score=65; regime="TRENDING"; status="APPROVED"
        elif bearish_1h and bearish_4h and e20_15<e50_15: decision="SELL"; conf=75; score=-65; regime="TRENDING"; status="APPROVED"
        else: decision="HOLD"; conf=20; score=-10; regime="RANGE"; status="REJECTED"; rejection.append(f"15M no confirm"); rejection.append(f"Quality {abs(score)}/100")
        return {"symbol": name, "price": price, "decision": decision, "status": status,"confidence": conf, "score": score, "regime": regime,"rsi": rsi_1h, "positive": positive, "rejection": rejection,"e20_1h": e20_1h, "e50_1h": e50_1h, "trend_4h": "BULL" if bullish_4h else "BEAR", "rsi_4h": rsi_4h}
    except: return None

