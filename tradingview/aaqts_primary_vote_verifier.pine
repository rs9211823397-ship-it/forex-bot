//@version=5
strategy("AAQTS Primary Vote Verifier", overlay=true, process_orders_on_close=true)

fastLength = input.int(20, "Fast EMA")
slowLength = input.int(50, "Slow EMA")
supertrendFactor = input.float(3.0, "Supertrend factor")
supertrendAtr = input.int(10, "Supertrend ATR")
higherTimeframe = input.timeframe("60", "Higher timeframe")

emaFast = ta.ema(close, fastLength)
emaSlow = ta.ema(close, slowLength)
[supertrend, supertrendDirection] = ta.supertrend(supertrendFactor, supertrendAtr)
[macdLine, macdSignal, _] = ta.macd(close, 12, 26, 9)

bullVotes = (emaFast > emaSlow ? 1 : 0) + (close > supertrend ? 1 : 0) + (macdLine > macdSignal ? 1 : 0)
bearVotes = (emaFast < emaSlow ? 1 : 0) + (close < supertrend ? 1 : 0) + (macdLine < macdSignal ? 1 : 0)

h1Fast = request.security(syminfo.tickerid, higherTimeframe, ta.ema(close, fastLength), lookahead=barmerge.lookahead_off)
h1Slow = request.security(syminfo.tickerid, higherTimeframe, ta.ema(close, slowLength), lookahead=barmerge.lookahead_off)
h1Bull = h1Fast > h1Slow
h1Bear = h1Fast < h1Slow

buy = barstate.isconfirmed and bullVotes >= 2 and h1Bull
sell = barstate.isconfirmed and bearVotes >= 2 and h1Bear

if buy
    strategy.entry("BUY", strategy.long)
if sell
    strategy.entry("SELL", strategy.short)

plot(emaFast, "EMA 20", color=color.teal)
plot(emaSlow, "EMA 50", color=color.orange)
plot(supertrend, "Supertrend", color=close > supertrend ? color.green : color.red)
plotshape(buy, title="AAQTS BUY candidate", style=shape.labelup, text="BUY", color=color.green)
plotshape(sell, title="AAQTS SELL candidate", style=shape.labeldown, text="SELL", color=color.red)

alertcondition(buy, "AAQTS BUY candidate", "AAQTS_PRIMARY,BUY,{{ticker}},{{interval}},{{time}}")
alertcondition(sell, "AAQTS SELL candidate", "AAQTS_PRIMARY,SELL,{{ticker}},{{interval}},{{time}}")
